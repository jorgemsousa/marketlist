{
  "expo": {
    "name": "marketlist",
    "slug": "marketlist",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketlist",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7e22ce"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jorgesousa.marketlist"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7e22ce"
      },
      "package": "com.jorgesousa.marketlist"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "97f7e58f-2c0f-4ff0-b106-490461795b25"
      },
      "router": {
        "origin": false
      }
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "jorgesousa"
  }
}
